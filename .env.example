# Copy to .env and fill in. Never commit .env.

# Moonshot / Kimi (research, discovery, qualification)
MOONSHOT_API_KEY=

# Hunter.io (contact email lookup)
HUNTER_API_KEY=

# Outreach sending (SMTP with an app password)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=

# Frontend: put the default email signature in frontend/.env.local
# VITE_OUTREACH_SIGNATURE="Your Name\nYour title, Your company\nyour-site.com"
