# Copy to .env and fill in. Never commit .env.

# Moonshot / Kimi (research, discovery, qualification)
MOONSHOT_API_KEY=

# Hunter.io (contact email lookup)
HUNTER_API_KEY=

# Outreach sending (SMTP with an app password)
SMTP_HOST=smtp.fastmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_APP_PASSWORD=
OUTREACH_FROM_NAME=
OUTREACH_FROM_EMAIL=

# Frontend: put the default email signature in frontend/.env.local
# VITE_OUTREACH_SIGNATURE="Your Name\nYour title, Your company\nyour-site.com"

# Local models (Ollama). Each step can run on Kimi (default) or locally.
# OLLAMA_URL=http://127.0.0.1:11434
# LOCAL_MODEL=qwen3.8:27b-q4_K_M
QUALIFY_BACKEND=kimi
# SEARCH_PROVIDER=tavily   # or searxng
# TAVILY_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8888
CHECK_BACKEND=kimi
# Email drafts:
OUTREACH_BACKEND=kimi
